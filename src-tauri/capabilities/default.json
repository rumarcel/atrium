{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-ui",
  "description": "Least-privilege capability for the trusted Personal Hub UI webview",
  "local": true,
  "webviews": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-is-fullscreen",
    "allow-check-service-health",
    "allow-get-server-metrics",
    "allow-get-background-runtime-preferences",
    "allow-save-background-runtime-preferences",
    "allow-get-desktop-integration-settings",
    "allow-save-desktop-integration-settings",
    "allow-set-desktop-startup-enabled",
    "allow-get-server-control-snapshot",
    "allow-save-server-control-settings",
    "allow-refresh-server-control-status",
    "allow-prepare-server-control-action",
    "allow-confirm-server-control-action",
    "allow-cancel-server-control-operation",
    "allow-dismiss-server-control-confirmation",
    "allow-get-appearance-settings",
    "allow-save-appearance-preferences",
    "allow-reset-appearance-preferences",
    "allow-import-appearance-preferences",
    "allow-export-appearance-preferences",
    "allow-get-service-configuration",
    "allow-save-service-configuration",
    "allow-reset-service-configuration",
    "allow-restore-service-configuration-backup",
    "allow-get-service-credential-statuses",
    "allow-set-service-credential",
    "allow-delete-service-credential",
    "allow-get-service-authentication-status",
    "allow-validate-service-authentication",
    "allow-discover-homarr-services",
    "allow-discover-server-inventory",
    "allow-get-download-center-snapshot",
    "allow-open-service-webview",
    "allow-activate-service-webview",
    "allow-hide-service-webviews",
    "allow-reconcile-service-webviews",
    "allow-reload-service-webview",
    "allow-close-service-webview",
    "allow-open-service-in-system-browser"
  ]
}
