{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Personal Hub",
  "version": "0.1.0",
  "identifier": "com.muhta.personal-hub",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Personal Hub",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "theme": "Dark",
        "backgroundColor": "#090A0D"
      },
      {
        "label": "widget-server",
        "title": "Personal Hub — Server",
        "url": "index.html#desktop-widget/server",
        "width": 420,
        "height": 380,
        "minWidth": 320,
        "minHeight": 300,
        "visible": false,
        "focus": false,
        "focusable": true,
        "resizable": true,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": false,
        "alwaysOnBottom": true,
        "skipTaskbar": true,
        "preventOverflow": true,
        "dragDropEnabled": false,
        "theme": "Dark",
        "backgroundColor": "#00000000"
      },
      {
        "label": "widget-storage",
        "title": "Personal Hub — Storage",
        "url": "index.html#desktop-widget/storage",
        "width": 400,
        "height": 320,
        "minWidth": 320,
        "minHeight": 240,
        "visible": false,
        "focus": false,
        "focusable": true,
        "resizable": true,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": false,
        "alwaysOnBottom": true,
        "skipTaskbar": true,
        "preventOverflow": true,
        "dragDropEnabled": false,
        "theme": "Dark",
        "backgroundColor": "#00000000"
      },
      {
        "label": "widget-services",
        "title": "Personal Hub — Service alerts",
        "url": "index.html#desktop-widget/services",
        "width": 400,
        "height": 340,
        "minWidth": 320,
        "minHeight": 260,
        "visible": false,
        "focus": false,
        "focusable": true,
        "resizable": true,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": false,
        "alwaysOnBottom": true,
        "skipTaskbar": true,
        "preventOverflow": true,
        "dragDropEnabled": false,
        "theme": "Dark",
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self' http://localhost:1420; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
